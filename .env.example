# Neon PostgreSQL: pega aquí la URL de conexión, con sslmode=require.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE_DE_DATOS?sslmode=require&channel_binding=require
# Genera una clave propia y privada para cada entorno.
SECRET_KEY=reemplaza-por-una-clave-aleatoria
# Solo activa el modo debug en desarrollo local.
FLASK_DEBUG=0
